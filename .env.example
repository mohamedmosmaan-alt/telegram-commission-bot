# Copy this file to ".env" and fill in real values. Never commit the real .env file.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
# Comma-separated Telegram numeric user IDs allowed to use /sync, /stats, /find, /duplicates
ADMIN_TELEGRAM_IDS=111111111,222222222

# --- Run mode ---
RUN_MODE=polling
WEBHOOK_BASE_URL=
WEBHOOK_SECRET_PATH=telegram-webhook
PORT=8000

# --- Google Sheets (recommended: BOTH tabs in ONE Google Sheet, see README) ---
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/service-account.json
# The long ID from your Sheet's URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# Tab holding the agent/phone directory (same columns as Fcc_Data.xlsx: Master, Name, اسم الوكالة, Phone num)
GOOGLE_SHEET_AGENTS_WORKSHEET=Fcc_Data
# Tab holding the flat commission table, one row per Master (same as the "Sheet1" tab
# of Fcc_Commission_New.xlsx — NOT the single-record template tab)
GOOGLE_SHEET_COMMISSION_WORKSHEET=Fcc_Commission

# --- Fallback: read raw .xlsx files from Drive instead of native Sheets ---
USE_EXCEL_FALLBACK=false
GOOGLE_DRIVE_EXCEL_FILE_ID_AGENTS=
GOOGLE_DRIVE_EXCEL_FILE_ID_COMMISSION=

# --- Sync ---
SYNC_INTERVAL_MINUTES=15

# --- Database ---
SQLITE_PATH=data/bot.db

# --- Duplicate phone handling (no duplicates in the current dataset, kept for safety) ---
# One of: master | agent_name
DUPLICATE_VERIFICATION_FIELD=master

# --- Phone normalization ---
DEFAULT_COUNTRY_CODE=20

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
